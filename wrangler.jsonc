{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xunan-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "STORAGE_BUCKET": "uploads",
    "AWS_ENDPOINT_URL_S3": "https://br-falling-king-bilia0g6.storage.c-5.ap-southeast-1.aws.neon.tech",
    "AWS_REGION": "ap-southeast-1",
    "JWT_TTL_DAYS": "30",
    "CORS_ORIGINS": ""
  },
}
