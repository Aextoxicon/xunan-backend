{
  "name": "xunan-server",
  "version": "1.0.0",
  "description": "Xunan hazard inspection API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/serve.ts",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc",
    "start": "node dist/serve.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:constraints": "tsx src/scripts/apply-constraints.ts",
    "db:setup": "tsx src/scripts/setup-db.ts",
    "db:seed": "tsx src/scripts/seed.ts"
  },
  "keywords": [],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1178.0",
    "@aws-sdk/s3-presigned-post": "^3.1178.0",
    "@aws-sdk/s3-request-presigner": "^3.1178.0",
    "@hono/node-server": "^2.1.11",
    "@hono/zod-validator": "^0.9.1",
    "@neon/config": "^1.14.8",
    "@neon/env": "^2.1.11",
    "aws4fetch": "^1.0.20",
    "files-sdk": "^3.2.1",
    "hono": "^4.13.22",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.10",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true
  }
}
