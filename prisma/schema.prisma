// 建表或改结构后执行：npm run db:setup

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              BigInt      @id @default(autoincrement()) @map("id")
  name            String      @map("name")
  role            String      @map("role")
  createdAt       DateTime    @default(now()) @db.Timestamptz(3) @map("created_at")

  inspections     Inspection[] @relation("Inspector")
  assignedHazards Hazard[]     @relation("AssignedHazards")
  createdHazards  Hazard[]     @relation("CreatedHazards")

  @@map("users")
}

model Room {
  id                  BigInt       @id @default(autoincrement()) @map("id")
  code                String       @unique @map("code")
  name                String       @map("name")
  location            String?      @map("location")
  latitude            Decimal?     @db.Decimal(9, 6) @map("latitude")
  longitude           Decimal?     @db.Decimal(9, 6) @map("longitude")
  radiusM             Int?         @map("radius_m")
  inspectionCycleDays Int          @default(7) @map("inspection_cycle_days")
  checkItemCodes      String[]     @default([]) @map("check_item_codes")
  active              Boolean      @default(true) @map("active")
  createdAt           DateTime     @default(now()) @db.Timestamptz(3) @map("created_at")

  inspections Inspection[] @relation("RoomInspections")
  hazards     Hazard[]     @relation("RoomHazards")

  @@map("rooms")
}

model Inspection {
  id              BigInt            @id @default(autoincrement()) @map("id")
  clientUuid      String            @unique @map("client_uuid")
  recordNo        String            @unique @map("record_no")
  roomId          BigInt            @map("room_id")
  inspectorId     BigInt            @map("inspector_id")
  inspectedAt     DateTime          @db.Timestamptz(3) @map("inspected_at")
  latitude        Decimal?          @db.Decimal(9, 6) @map("latitude")
  longitude       Decimal?          @db.Decimal(9, 6) @map("longitude")
  score           Decimal?          @db.Decimal(5, 1) @map("score")
  createdAt       DateTime          @default(now()) @db.Timestamptz(3) @map("created_at")

  room            Room              @relation("RoomInspections", fields: [roomId], references: [id])
  inspector       User              @relation("Inspector", fields: [inspectorId], references: [id])
  items           InspectionItem[]
  hazards         Hazard[]          @relation("InspectionHazards")

  @@index([roomId])
  @@index([inspectedAt])
  @@map("inspections")
}

model InspectionItem {
  id            BigInt      @id @default(autoincrement()) @map("id")
  inspectionId  BigInt      @map("inspection_id")
  itemCode      String      @map("item_code")
  category      String      @map("category")
  itemName      String      @map("item_name")
  result        String      @map("result")
  photoKeys     String[]    @default([]) @map("photo_keys")
  remark        String?     @map("remark")

  inspection    Inspection  @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  hazards       Hazard[]    @relation("ItemHazards")

  @@index([inspectionId])
  @@map("inspection_items")
}

model Hazard {
  id                BigInt      @id @default(autoincrement()) @map("id")
  clientUuid        String      @unique @map("client_uuid")
  hazardNo          String      @unique @map("hazard_no")
  roomId            BigInt      @map("room_id")
  inspectionId      BigInt?     @map("inspection_id")
  inspectionItemId  BigInt?     @map("inspection_item_id")
  description       String      @map("description")
  level             String      @map("level")
  photoKeys         String[]    @default([]) @map("photo_keys")
  assigneeId        BigInt      @map("assignee_id")
  dueAt             DateTime    @db.Timestamptz(3) @map("due_at")
  status            String      @default("待整改") @map("status")
  closedAt          DateTime?   @db.Timestamptz(3) @map("closed_at")
  createdBy         BigInt      @map("created_by")
  statusHistory     Json        @default("[]") @map("status_history")
  createdAt         DateTime    @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt         DateTime    @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")
  remindCount       Int         @default(0) @map("remind_count")
  lastRemindedAt    DateTime?   @db.Timestamptz(3) @map("last_reminded_at")

  room              Room            @relation("RoomHazards", fields: [roomId], references: [id])
  inspection        Inspection?     @relation("InspectionHazards", fields: [inspectionId], references: [id])
  inspectionItem    InspectionItem? @relation("ItemHazards", fields: [inspectionItemId], references: [id])
  assignee          User            @relation("AssignedHazards", fields: [assigneeId], references: [id])
  createdByUser     User            @relation("CreatedHazards", fields: [createdBy], references: [id])

  @@index([roomId])
  @@index([inspectionId])
  @@index([assigneeId])
  @@index([status])
  @@index([dueAt])
  @@map("hazards")
}
