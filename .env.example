DATABASE_URL=postgresql://user:password@host/db?sslmode=require
AWS_ENDPOINT_URL_S3=https://br-xxx.storage.<region>.aws.neon.tech
AWS_ACCESS_KEY_ID=nak_live_xxx
AWS_SECRET_ACCESS_KEY=nsk_live_xxx
AWS_REGION=ap-southeast-1
STORAGE_BUCKET=uploads
# CORS 允许的来源，逗号分隔；填 * 表示放行任意来源；留空则不下发 CORS 头
CORS_ORIGINS=http://localhost:5173,https://app.example.com
# 仅本地 serve() 使用，部署到 Vercel/Workers 不需要
PORT=3000
